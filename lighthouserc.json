{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/about/index.html",
        "http://localhost/colophon/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.98
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.98
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.98
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 30000
          }
        ],
        "resource-summary:document:size": [
          "error",
          {
            "maxNumericValue": 60000
          }
        ],
        "resource-summary:font:count": [
          "error",
          {
            "maxNumericValue": 3
          }
        ]
      }
    }
  }
}
