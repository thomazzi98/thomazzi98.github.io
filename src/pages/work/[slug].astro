---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { describeDefinition } from '../../bench/render/describe';
import { isScenarioId, loadScenario } from '../../bench/scenarios';
import BenchFrame from '../../components/bench/BenchFrame.astro';
import Base from '../../layouts/Base.astro';
import { loadContent } from '../../lib/content';
import { formatPeriod } from '../../lib/period';
import { selectCaseStudies } from '../../lib/projects';
import { statusLabels } from '../../lib/status';
import { createTechnologyNameLookup } from '../../lib/technologies';

export const getStaticPaths = (async () => {
  const { projects } = await loadContent();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { roles, projects, technologies, companyOf } = await loadContent();
const technologyName = createTechnologyNameLookup(technologies);
const { Content } = await render(project);
const role = roles.find((candidate) => candidate.id === project.data.role?.id);
const benchIndex = selectCaseStudies(projects).findIndex(
  (candidate) => candidate.id === project.id,
);
const benchNumber = benchIndex === -1 ? undefined : String(benchIndex + 1).padStart(2, '0');
const scenario = isScenarioId(project.id) ? await loadScenario(project.id) : undefined;
const evidenceLabel = { repo: 'Repository', company: 'Employer', none: 'No public artefact' };
---

<Base title={`${project.data.title} · Rafael Thomazzi`} description={project.data.tagline}>
  <article class="case">
    <header class="case__head">
      <p class="kicker">
        {benchNumber !== undefined && <span>Bench {benchNumber} · </span>}
        <span>{statusLabels[project.data.status]}</span>
        <span> · built {formatPeriod(project.data.period)}</span>
        {companyOf(project) !== undefined && <span> · {companyOf(project)}</span>}
      </p>
      <h1>{project.data.title}</h1>
      <p class="case__tagline">{project.data.tagline}</p>
    </header>

    {
      scenario !== undefined && isScenarioId(project.id) && (
        <section class="case__bench" id="bench" aria-labelledby="bench-title">
          <h2 id="bench-title" class="kicker">
            Pull the lever, then read why
          </h2>
          <p class="case__invite muted">{scenario.invitation}</p>
          <BenchFrame
            id={project.id}
            module={scenario}
            title={project.data.title}
            description={describeDefinition(scenario.definition)}
            announce
          />
        </section>
      )
    }

    <div class="case__body">
      <div class="prose">
        <Content />
      </div>
      <aside class="case__aside">
        {
          role !== undefined && (
            <section>
              <h2 class="kicker">Role</h2>
              <p>
                <strong>{role.data.title}</strong>
                <br />
                <span class="muted">
                  {role.data.company} · {role.data.companyGloss}
                </span>
              </p>
            </section>
          )
        }
        <section>
          <h2 class="kicker">Stack</h2>
          <ul class="case__stack">
            {project.data.stack.map((id) => <li>{technologyName(id)}</li>)}
          </ul>
        </section>
        <section>
          <h2 class="kicker">Evidence</h2>
          <ul>
            {
              project.data.evidence.map((item) => (
                <li>
                  <span class="muted">{evidenceLabel[item.kind]}</span>
                  {item.label !== undefined && (
                    <>
                      {' · '}
                      {item.url !== undefined ? <a href={item.url}>{item.label}</a> : item.label}
                    </>
                  )}
                </li>
              ))
            }
          </ul>
        </section>
        {
          project.data.confidentiality !== undefined && (
            <section>
              <h2 class="kicker">Confidentiality</h2>
              <p class="muted">{project.data.confidentiality}</p>
            </section>
          )
        }
        <section>
          <h2 class="kicker">Machine-readable</h2>
          <p>
            <a href="/resume.txt">resume.txt</a> · <a href="/llms.txt">llms.txt</a>
            {
              scenario !== undefined && (
                <>
                  {' · '}
                  <a href={`/bench/${project.id}.json`}>bench transcript</a>
                </>
              )
            }
          </p>
        </section>
      </aside>
    </div>
  </article>
</Base>
