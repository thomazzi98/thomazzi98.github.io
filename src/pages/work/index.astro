---
import { isScenarioId } from '../../bench/scenarios';
import Base from '../../layouts/Base.astro';
import { loadContent } from '../../lib/content';
import { formatPeriod } from '../../lib/period';
import { selectAlsoBuilt, selectCaseStudies } from '../../lib/projects';
import { createTechnologyNameLookup } from '../../lib/technologies';

const { projects, technologies, companyOf } = await loadContent();
const technologyName = createTechnologyNameLookup(technologies);
const caseStudies = selectCaseStudies(projects);
const alsoBuilt = selectAlsoBuilt(projects);
const benchNumber = (index: number) => String(index + 1).padStart(2, '0');
const benched = caseStudies.filter((project) => isScenarioId(project.id)).length;
---

<Base
  title="Work · Rafael Thomazzi"
  description="Five case studies, each a replayable bench of a production decision, and the smaller things built along the way."
>
  <section class="page-head">
    <h1>Work</h1>
    <p class="measure muted">
      Each case study is a decision record: the constraints, the alternative on the table, what I
      chose, what it cost, and what happened. {benched} of {caseStudies.length} open on a bench you can
      operate before you read.
    </p>
  </section>

  <section class="section" aria-labelledby="cases-title">
    <div class="section__head">
      <h2 id="cases-title">Case studies</h2>
      <p class="kicker">Numbered as on the tie-up</p>
    </div>
    <ol class="work-list">
      {
        caseStudies.map((project, index) => (
          <li class="work-row">
            <span class="work-row__number mono">{benchNumber(index)}</span>
            <div class="work-row__body">
              <h3>
                <a href={`/work/${project.id}/`}>{project.data.title}</a>
              </h3>
              <p class="muted">{project.data.tagline}</p>
              <p class="work-row__stack mono">
                {project.data.stack.slice(0, 6).map(technologyName).join(' · ')}
              </p>
            </div>
            <div class="work-row__meta mono">
              <span>{project.data.status.replaceAll('-', ' ')}</span>
              <span>{formatPeriod(project.data.period)}</span>
              {companyOf(project) !== undefined && <span>{companyOf(project)}</span>}
              {isScenarioId(project.id) && <span class="work-row__bench">bench</span>}
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" aria-labelledby="also-title">
    <div class="section__head">
      <h2 id="also-title">Also built</h2>
      <p class="kicker">Smaller, but real</p>
    </div>
    <ul class="work-list work-list--compact">
      {
        alsoBuilt.map((project) => (
          <li class="work-row">
            <span class="work-row__number mono" aria-hidden="true">
              ·
            </span>
            <div class="work-row__body">
              <h3>
                <a href={`/work/${project.id}/`}>{project.data.title}</a>
              </h3>
              <p class="muted">{project.data.tagline}</p>
            </div>
            <div class="work-row__meta mono">
              <span>{project.data.status.replaceAll('-', ' ')}</span>
              <span>{formatPeriod(project.data.period)}</span>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
