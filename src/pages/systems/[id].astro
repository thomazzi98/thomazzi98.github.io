---
import type { GetStaticPaths } from 'astro';
import EvidenceLinks from '../../components/EvidenceLinks.astro';
import FlowStage from '../../components/FlowStage.astro';
import FragmentBlock from '../../components/FragmentBlock.astro';
import { SystemExplorer } from '../../islands/explorer/SystemExplorer';
import { StateMachineExplorer } from '../../islands/state/StateMachineExplorer';
import Base from '../../layouts/Base.astro';
import { loadContent } from '../../lib/content';
import { identity } from '../../lib/identity';
import { createTechnologyNameLookup } from '../../lib/technologies';
import { systems } from '../../systems';
import { commitUrl, evidenceUrl, repositoryUrl, shortCommit } from '../../systems/evidence';
import { maturityText, maturityTone } from '../../systems/presentation';
import type { Flow } from '../../systems/schema';

export const getStaticPaths = (() =>
  systems.map((system) => ({
    params: { id: system.id },
    props: { system },
  }))) satisfies GetStaticPaths;

const { system } = Astro.props;
const { repository } = system;
const { technologies } = await loadContent();
const technologyName = createTechnologyNameLookup(technologies);
const technologyNames = Object.fromEntries(
  technologies.map((technology) => [technology.id, technology.data.name]),
);
const flowsOfKind = (...kinds: Flow['kind'][]) =>
  system.flows.filter((flow) => kinds.includes(flow.kind));
const pathFlows = flowsOfKind('request', 'asynchronous');
const failureFlows = flowsOfKind('failure', 'recovery');
const securityFlows = flowsOfKind('security');
const site = Astro.site?.href ?? '/';
const sourceSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: system.name,
  description: system.tagline,
  codeRepository: repositoryUrl(repository),
  programmingLanguage: 'TypeScript',
  runtimePlatform: repository.runtime,
  version: repository.pinnedCommit,
  ...(repository.license === undefined ? {} : { license: repository.license }),
  author: { '@type': 'Person', '@id': `${site}#person`, name: identity.name, url: site },
  url: new URL(Astro.url.pathname, Astro.site).href,
};
const sections = [
  { id: 'problem', label: 'Problem' },
  { id: 'architecture', label: 'Architecture' },
  { id: 'flows', label: 'Flows' },
  ...(system.stateMachines.length > 0 ? [{ id: 'state', label: 'State' }] : []),
  ...(failureFlows.length > 0 ? [{ id: 'failure', label: 'Failure handling' }] : []),
  { id: 'security', label: 'Security' },
  { id: 'verification', label: 'Verification' },
  { id: 'decisions', label: 'Decisions' },
  { id: 'code', label: 'Code' },
  { id: 'source', label: 'Source' },
];
const imageAlt = `${system.name}. ${system.tagline} Pinned at ${shortCommit(repository)} on ${repository.pinnedOn}.`;
---

<Base
  title={`${system.name} · ${identity.name}`}
  description={system.tagline}
  image={`/og/${system.id}.png`}
  imageAlt={imageAlt}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(sourceSchema).replaceAll('<', '\\u003c')}
    />
  </Fragment>

  <header class="system-head">
    <div>
      <p class="kicker">
        System · <a href={repositoryUrl(repository)}>{repository.owner}/{repository.name}</a> · pinned{
          ' '
        }
        <a href={commitUrl(repository)} class="mono">{shortCommit(repository)}</a>
      </p>
      <h1>{system.name}</h1>
      <p class="hero__thesis">{system.thesis}</p>
      <div class="system-head__facts">
        <span class="badge" data-tone={maturityTone[system.maturity.label]}>
          {maturityText(system.maturity.label)}
        </span>
        <span class="kicker"
          >{repository.commitCount} commits · {repository.firstCommitOn} → {
            repository.pinnedOn
          }</span
        >
        <span class="kicker">{repository.runtime} · {repository.packageManager}</span>
      </div>
    </div>
    <div class="panel maturity">
      <div class="panel__head">
        <strong>Where it stands</strong><span>at {shortCommit(repository)}</span>
      </div>
      <div class="panel__body">
        <p>{system.maturity.statement}</p>
        <p class="evidence">
          <EvidenceLinks repository={repository} evidence={system.maturity.evidence} />
        </p>
      </div>
    </div>
  </header>

  <nav class="system-nav" aria-label="Sections">
    {sections.map((section) => <a href={`#${section.id}`}>{section.label}</a>)}
  </nav>

  <section class="section" id="problem" aria-labelledby="problem-title">
    <div class="section__head">
      <h2 id="problem-title">The problem</h2>
      <p class="kicker">Why it exists</p>
    </div>
    <div class="prose">
      {system.problem.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section" id="architecture" aria-labelledby="architecture-title">
    <div class="section__head">
      <h2 id="architecture-title">Architecture</h2>
      <p class="kicker">
        {system.nodes.length} parts · {system.edges.length} connections · select any to inspect
      </p>
    </div>
    <SystemExplorer
      client:visible
      systemId={system.id}
      title={`${system.name} architecture`}
      description={system.tagline}
      repository={repository}
      nodes={system.nodes}
      edges={system.edges}
      technologyNames={technologyNames}
    />
    <div class="stack">
      <p class="kicker">Technology in context</p>
      <dl class="stack__list">
        {
          system.stack.map((entry) => (
            <div class="stack__entry">
              <dt>{technologyName({ id: entry.technology })}</dt>
              <dd>
                {entry.role}{' '}
                <span class="evidence">
                  <EvidenceLinks repository={repository} evidence={entry.evidence} />
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section section--deferred" id="flows" aria-labelledby="flows-title">
    <div class="section__head">
      <h2 id="flows-title">How a request travels</h2>
      <p class="kicker">Replays of the documented flows · simulation, not live traffic</p>
    </div>
    <FlowStage system={system} flows={pathFlows} autoplay />
  </section>

  {
    system.stateMachines.length > 0 && (
      <section class="section section--deferred" id="state" aria-labelledby="state-title">
        <div class="section__head">
          <h2 id="state-title">Data and state</h2>
          <p class="kicker">Lifecycles copied from the tables the code enforces</p>
        </div>
        <div class="machines">
          {system.stateMachines.map((machine) => (
            <article class="panel machine" aria-labelledby={`machine-${machine.id}`}>
              <div class="panel__head">
                <strong id={`machine-${machine.id}`}>{machine.name}</strong>
                <span>
                  {machine.statuses.length} statuses · {machine.transitions.length} transitions
                </span>
              </div>
              <div class="panel__body machine__body">
                <StateMachineExplorer client:visible machine={machine} />
                {machine.notes.length > 0 && (
                  <ul class="machine__notes">
                    {machine.notes.map((note) => (
                      <li>{note}</li>
                    ))}
                  </ul>
                )}
              </div>
              <p class="panel__foot">
                <EvidenceLinks repository={repository} evidence={machine.evidence} />
              </p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    failureFlows.length > 0 && (
      <section class="section section--deferred" id="failure" aria-labelledby="failure-title">
        <div class="section__head">
          <h2 id="failure-title">Failure handling</h2>
          <p class="kicker">Pull a lever and watch the design answer</p>
        </div>
        <FlowStage system={system} flows={failureFlows} />
      </section>
    )
  }

  <section class="section section--deferred" id="security" aria-labelledby="security-title">
    <div class="section__head">
      <h2 id="security-title">Security boundaries</h2>
      <p class="kicker">Each concern names its control and the code that holds it</p>
    </div>
    <dl class="controls">
      {
        system.security.map((control) => (
          <div class="controls__entry">
            <dt>{control.concern}</dt>
            <dd>
              {control.control}{' '}
              <span class="evidence">
                <EvidenceLinks repository={repository} evidence={control.evidence} />
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
    {securityFlows.length > 0 && <FlowStage system={system} flows={securityFlows} />}
  </section>

  <section class="section section--deferred" id="verification" aria-labelledby="verification-title">
    <div class="section__head">
      <h2 id="verification-title">How it is verified</h2>
      <p class="kicker">Tests, checks and the pipeline that runs them</p>
    </div>
    <div class="layers">
      {
        system.verification.layers.map((layer) => (
          <article class="panel">
            <div class="panel__head">
              <strong>{layer.name}</strong>
              <span>{layer.tool}</span>
            </div>
            <div class="panel__body">
              <p>{layer.proves}</p>
              <ul class="layers__examples">
                {layer.examples.map((example) => (
                  <li>
                    <a class="evidence" href={evidenceUrl(repository, { path: example.path })}>
                      {example.path}
                    </a>
                    <span class="muted"> {example.proves}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
    {
      system.verification.checks.length > 0 && (
        <div
          class="checks-scroll"
          role="region"
          tabindex="0"
          aria-label="Checks the repository runs on itself, scrolls sideways"
        >
          <table class="checks">
            <caption class="kicker">Checks the repository runs on itself</caption>
            <thead>
              <tr>
                <th scope="col">Command</th>
                <th scope="col">Refuses</th>
              </tr>
            </thead>
            <tbody>
              {system.verification.checks.map((check) => (
                <tr>
                  <td class="mono">{check.command}</td>
                  <td>{check.refuses}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
    {
      system.verification.pipeline.length > 0 && (
        <ol class="pipeline">
          {system.verification.pipeline.map((stage, index) => (
            <li>
              <span class="pipeline__number mono">{String(index + 1).padStart(2, '0')}</span>
              <span>
                <strong>{stage.name}</strong> <span class="muted">{stage.detail}</span>
              </span>
            </li>
          ))}
        </ol>
      )
    }
    <p class="evidence">
      <EvidenceLinks repository={repository} evidence={system.verification.evidence} />
    </p>
  </section>

  <section class="section section--deferred" id="decisions" aria-labelledby="decisions-title">
    <div class="section__head">
      <h2 id="decisions-title">Decisions</h2>
      <p class="kicker">What was chosen, what was refused, what it costs</p>
    </div>
    <div class="decisions">
      {
        system.decisions.map((decision) => (
          <article class="decision" id={`decision-${decision.id}`}>
            <h3>{decision.title}</h3>
            <p class="kicker">{decision.themes.join(' · ')}</p>
            <div class="prose">
              <p>{decision.decision}</p>
              {decision.alternatives.length > 0 && (
                <div>
                  <p class="muted">Refused:</p>
                  <ul class="decision__refused">
                    {decision.alternatives.map((alternative) => (
                      <li>{alternative}</li>
                    ))}
                  </ul>
                </div>
              )}
              <p>
                <span class="muted">Cost:</span> {decision.cost}
              </p>
            </div>
            <p class="evidence">
              <EvidenceLinks repository={repository} evidence={decision.evidence} />
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section--deferred" id="code" aria-labelledby="code-title">
    <div class="section__head">
      <h2 id="code-title">Code as evidence</h2>
      <p class="kicker">Copied from the pinned commit and compared byte for byte in CI</p>
    </div>
    <div class="fragments">
      {
        system.fragments.map((fragment) => (
          <FragmentBlock systemId={system.id} repository={repository} fragment={fragment} />
        ))
      }
    </div>
  </section>

  <section class="section section--deferred" id="source" aria-labelledby="source-title">
    <div class="section__head">
      <h2 id="source-title">Source</h2>
      <p class="kicker">Read it at the commit this page describes</p>
    </div>
    <table class="facts">
      <caption class="sr-only">Repository facts checked against git by the test suite</caption>
      <tbody>
        <tr
          ><th scope="row">Repository</th><td
            ><a href={repositoryUrl(repository)}>github.com/{repository.owner}/{repository.name}</a
            ></td
          ></tr
        >
        <tr
          ><th scope="row">Pinned commit</th><td
            ><a href={commitUrl(repository)}>{repository.pinnedCommit}</a></td
          ></tr
        >
        <tr
          ><th scope="row">Commits</th><td
            >{repository.commitCount}, from {repository.firstCommitOn} to {repository.pinnedOn}</td
          ></tr
        >
        <tr
          ><th scope="row">Runtime</th><td>{repository.runtime} · {repository.packageManager}</td
          ></tr
        >
        {
          repository.license !== undefined && (
            <tr>
              <th scope="row">License</th>
              <td>{repository.license}</td>
            </tr>
          )
        }
        <tr
          ><th scope="row">This page as data</th><td
            ><a href={`/systems/${system.id}.json`} class="mono">/systems/{system.id}.json</a></td
          ></tr
        >
      </tbody>
    </table>
    {
      system.limitations.length > 0 && (
        <div class="limitations">
          <p class="kicker">Limits the repository states about itself</p>
          <ul>
            {system.limitations.map((limitation) => (
              <li>
                {limitation.statement}{' '}
                <span class="evidence">
                  <EvidenceLinks repository={repository} evidence={limitation.evidence} />
                </span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <script>
    // The sticky section nav marks the section under the reading line, so a long page keeps its place.
    const nav = document.querySelector('.system-nav');
    const links = [...(nav?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]') ?? [])];
    const linkById = new Map(links.map((link) => [link.hash.slice(1), link]));
    const sections = [...linkById.keys()].flatMap((id) => {
      const section = document.getElementById(id);
      return section === null ? [] : [section];
    });
    const markCurrent = (id: string | undefined) => {
      for (const [sectionId, link] of linkById) {
        if (sectionId === id) {
          link.setAttribute('aria-current', 'true');
          continue;
        }
        link.removeAttribute('aria-current');
      }
    };
    const visible = new Set<string>();
    const firstVisible = () => sections.find((section) => visible.has(section.id))?.id;
    if (sections.length > 0 && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              visible.add(entry.target.id);
              continue;
            }
            visible.delete(entry.target.id);
          }
          const current = firstVisible();
          const aboveFirst = (sections[0]?.getBoundingClientRect().top ?? 0) > 0;
          if (current !== undefined || aboveFirst) {
            markCurrent(current);
          }
        },
        { rootMargin: '-12% 0px -72% 0px' },
      );
      for (const section of sections) {
        observer.observe(section);
      }
    }
  </script>
</Base>
