---
import { ArchitectureMap, type Lens, type MapPanel } from '../islands/map/ArchitectureMap';
import Base from '../layouts/Base.astro';
import { systems } from '../systems';
import { divergences } from '../systems/divergences';
import { commitUrl, evidenceLabel, evidenceUrl, shortCommit } from '../systems/evidence';
import { toSchematicEdges, toSchematicNodes } from '../systems/presentation';
import type { Evidence, SystemModel } from '../systems/schema';
import {
  patternSystemIds,
  presenceTone,
  sharedPatterns,
  type PatternSystemId,
} from '../systems/shared-patterns';

const isPatternSystemId = (id: string): id is PatternSystemId =>
  (patternSystemIds as readonly string[]).includes(id);

const patternSystems = systems.filter((system) => isPatternSystemId(system.id));

const cite = (system: SystemModel, evidence: Evidence) => ({
  href: evidenceUrl(system.repository, evidence),
  label: evidenceLabel(evidence),
});

const labelsFor = (system: SystemModel, nodeIds: readonly string[]): string[] =>
  nodeIds.flatMap((nodeId) => {
    const node = system.nodes.find((candidate) => candidate.id === nodeId);
    return node === undefined ? [] : [node.label];
  });

const litText = (system: SystemModel, nodeIds: readonly string[]): string => {
  const lit = labelsFor(system, nodeIds);
  return lit.length === 0
    ? 'No part is lit: this lives in scripts and documents'
    : `Lit: ${lit.join(', ')}`;
};

const panels: MapPanel[] = systems.map((system) => ({
  systemId: system.id,
  name: system.name,
  href: `/systems/${system.id}/`,
  description: system.tagline,
  nodes: toSchematicNodes(system.nodes),
  edges: toSchematicEdges(system.edges),
}));

const lenses: Lens[] = sharedPatterns.map((pattern) => ({
  id: pattern.id,
  name: pattern.name,
  systems: Object.fromEntries(
    patternSystems.flatMap((system) =>
      isPatternSystemId(system.id) ? [[system.id, pattern.systems[system.id].nodes]] : [],
    ),
  ),
}));

const readingFor = (patternId: string, systemId: string) => {
  const pattern = sharedPatterns.find((candidate) => candidate.id === patternId);
  if (pattern === undefined || !isPatternSystemId(systemId)) {
    return undefined;
  }
  return pattern.systems[systemId];
};
---

<Base
  title="Architecture · Rafael Thomazzi"
  description="Three independent systems that share no code and cooperate through one explicit contract, drawn side by side, with a lens for each engineering pattern they share."
>
  <section class="page-head">
    <p class="kicker">Architecture</p>
    <h1>Independent systems, one approach</h1>
    <p class="lead">
      CryptoPay, the WhatsApp Notification Platform and the Mini Payment Gateway are three
      independent repositories: no shared package, no shared code, no shared database. Where they
      meet is one explicit contract, and it runs in one direction — the gateway asks CryptoPay for a
      crypto destination and hands the WhatsApp platform a paid event, over their public HTTP APIs
      and a signed webhook. The <a href="/demo/">live page</a> drives that flow for real. What they share
      otherwise is an approach, and each lens below lights the parts that carry it.
    </p>
  </section>

  <section class="section" aria-labelledby="map-title">
    <div class="section__head">
      <h2 id="map-title">The map</h2>
      <p class="kicker">One system per row</p>
      <p class="map__intro muted">
        Every part and connection of all three. Pick a lens to light what carries it.
      </p>
    </div>
    <ArchitectureMap client:visible panels={panels} lenses={lenses}>
      <Fragment slot="readings">
        {
          sharedPatterns.map((pattern) => (
            <section
              class="map__reading-block"
              data-lens-reading={pattern.id}
              aria-labelledby={`lens-${pattern.id}-title`}
              hidden
            >
              <p class="map__reading-head">
                <strong id={`lens-${pattern.id}-title`}>{pattern.name}</strong>
              </p>
              <div class="map__reading-body">
                <div
                  class="map__description"
                  data-copy-of={`#pattern-${pattern.id} [data-description]`}
                />
                <dl class="map__lit">
                  {patternSystems.map((system) => {
                    const reading = readingFor(pattern.id, system.id);
                    if (reading === undefined) {
                      return null;
                    }
                    return (
                      <div>
                        <dt>{system.shortName}</dt>
                        <dd>{litText(system, reading.nodes)}</dd>
                      </div>
                    );
                  })}
                </dl>
              </div>
              <div class="map__reading-foot">
                <details class="map__notes">
                  <summary>Notes and evidence</summary>
                  <dl class="map__notes-list">
                    {patternSystems.map((system) => (
                      <div>
                        <dt>{system.shortName}</dt>
                        <dd data-copy-of={`#pattern-${pattern.id} [data-system="${system.id}"]`} />
                      </div>
                    ))}
                  </dl>
                </details>
                <a class="kicker map__matrix-link" href={`#pattern-${pattern.id}`}>
                  lens · in the matrix <span class="sr-only">for {pattern.name}</span>
                </a>
              </div>
            </section>
          ))
        }
      </Fragment>
    </ArchitectureMap>
  </section>

  <section class="section" aria-labelledby="matrix-title">
    <div class="section__head">
      <h2 id="matrix-title">What they share</h2>
      <p class="kicker">
        {sharedPatterns.length} patterns across three repositories · verified at the pinned commits
      </p>
    </div>
    <div
      class="matrix__scroll"
      role="region"
      tabindex="0"
      aria-label="Pattern matrix, scrolls sideways"
    >
      <table class="matrix">
        <caption class="sr-only">
          Presence of each shared pattern in each system, with a note and evidence at the pinned
          commit
        </caption>
        <thead>
          <tr>
            <th scope="col">Pattern</th>
            {
              systems.map((system) => (
                <th scope="col">
                  {system.shortName}
                  <a class="evidence" href={commitUrl(system.repository)}>
                    pinned {shortCommit(system.repository)}
                  </a>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            sharedPatterns.map((pattern) => (
              <tr id={`pattern-${pattern.id}`}>
                <th scope="row">
                  {pattern.name}
                  <div data-description>
                    <p class="matrix__description">{pattern.description}</p>
                  </div>
                </th>
                {systems.map((system) => {
                  const reading = readingFor(pattern.id, system.id);
                  if (reading === undefined) {
                    return <td />;
                  }
                  return (
                    <td data-system={system.id}>
                      <span class="badge" data-tone={presenceTone[reading.presence]}>
                        {reading.presence}
                      </span>
                      <p>{reading.note}</p>
                      <p class="evidence">
                        {reading.evidence.map((entry, index) => (
                          <>
                            {index > 0 && ' · '}
                            <a href={cite(system, entry).href}>{cite(system, entry).label}</a>
                          </>
                        ))}
                      </p>
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="section" aria-labelledby="diverge-title">
    <div class="section__head">
      <h2 id="diverge-title">Where they diverge</h2>
      <p class="kicker">Chosen differently, on purpose, and recorded</p>
    </div>
    <dl class="divergences">
      {
        divergences.map((divergence) => (
          <div class="divergence" id={`divergence-${divergence.id}`}>
            <dt>{divergence.topic}</dt>
            <dd>
              <p>{divergence.detail}</p>
              <dl class="divergence__systems">
                {patternSystems.map((system) => {
                  if (!isPatternSystemId(system.id)) {
                    return null;
                  }
                  const reading = divergence.systems[system.id];
                  return (
                    <div class="divergence__system">
                      <dt>{system.shortName}</dt>
                      <dd>
                        {reading.note}
                        <span class="evidence">
                          {reading.evidence.map((entry, index) => (
                            <>
                              {index > 0 && ' · '}
                              <a href={cite(system, entry).href}>{cite(system, entry).label}</a>
                            </>
                          ))}
                        </span>
                      </dd>
                    </div>
                  );
                })}
              </dl>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>
