---
import Base from '../layouts/Base.astro';
import { loadContent } from '../lib/content';
import { compareByStartDescending, formatPeriod } from '../lib/period';

const { roles } = await loadContent();
const latestRole = [...roles].sort(compareByStartDescending)[0];
---

<Base
  title="Rafael Thomazzi · Senior Software Engineer, backend"
  description="Backend engineer with six years in Node.js and TypeScript: integration platforms, payment providers, and smart-contract backends, from first design through production support."
>
  <section class="py-16 md:py-24">
    <p class="font-mono text-xs tracking-label text-ink-muted uppercase">
      Senior Software Engineer · Backend · Available now, remote from Brazil
    </p>
    <h1 class="mt-6 max-w-(--measure) text-fluid-2xl leading-[1.05] font-semibold tracking-tight">
      I build the backend between enterprise systems, payment providers, and blockchains.
    </h1>
    <p class="mt-8 max-w-(--measure) text-fluid-lg text-ink-muted">
      Six years in Node.js and TypeScript, usually from first design through production support.
      Most recently payment-gateway integrations at Brainrocket and the backend of an integration
      platform at Sky.One.
    </p>
    {
      latestRole && (
        <p class="mt-10 font-mono text-sm text-ink-muted">
          <span class="tracking-label uppercase">Last role</span> · {latestRole.data.title},{' '}
          {latestRole.data.company} · {formatPeriod(latestRole.data.period)}
        </p>
      )
    }
  </section>
</Base>
