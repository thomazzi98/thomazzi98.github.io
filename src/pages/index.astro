---
import ProjectCard from '../components/ProjectCard.astro';
import Base from '../layouts/Base.astro';
import { loadContent } from '../lib/content';
import { identity } from '../lib/identity';
import { compareByStartDescending, formatPeriod } from '../lib/period';
import { selectFeatured } from '../lib/projects';
import { createTechnologyNameLookup } from '../lib/technologies';

const { roles, projects, technologies } = await loadContent();
const technologyName = createTechnologyNameLookup(technologies);
const companyByRoleId = new Map(roles.map((role) => [role.id, role.data.company]));
const companyOf = (project: (typeof projects)[number]) =>
  project.data.role === undefined ? undefined : companyByRoleId.get(project.data.role.id);
const latestRole = [...roles].sort(compareByStartDescending)[0];
const featured = selectFeatured(projects);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  jobTitle: 'Senior Software Engineer',
  description: identity.summary,
  email: `mailto:${identity.email}`,
  url: Astro.site?.href,
  sameAs: [identity.links.github, identity.links.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: 'Sorocaba', addressCountry: 'BR' },
};
---

<Base title="Rafael Thomazzi · Senior Software Engineer, backend" description={identity.summary}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} slot="head" />
  <section class="py-16 md:py-24">
    <p class="font-mono text-xs tracking-label text-ink-muted uppercase">
      {identity.headline} · {identity.availability}
    </p>
    <h1 class="mt-6 max-w-(--measure) text-fluid-2xl leading-[1.05] font-semibold tracking-tight">
      {identity.positioning}
    </h1>
    <p class="mt-8 max-w-(--measure) text-fluid-lg text-ink-muted">
      Six years in Node.js and TypeScript, usually from first design through production support.
      Most recently payment-gateway integrations at Brainrocket and the backend of an integration
      platform at Sky.One.
    </p>
    {
      latestRole && (
        <p class="mt-10 font-mono text-sm text-ink-muted">
          <span class="tracking-label uppercase">Last role</span> · {latestRole.data.title},{' '}
          {latestRole.data.company} · {formatPeriod(latestRole.data.period)}
        </p>
      )
    }
  </section>

  <section aria-labelledby="selected-work" class="pb-16 md:pb-24">
    <div class="flex items-baseline justify-between">
      <h2 id="selected-work" class="font-mono text-xs tracking-label text-ink-muted uppercase">
        Selected work
      </h2>
      <a href="/work/" class="font-mono text-xs text-ink-muted hover:text-ink">All work →</a>
    </div>
    <div class="mt-4">
      {
        featured.map((project) => (
          <ProjectCard
            project={project}
            company={companyOf(project)}
            technologyName={technologyName}
          />
        ))
      }
    </div>
  </section>
</Base>
