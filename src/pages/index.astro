---
import Base from '../layouts/Base.astro';
import { loadContent } from '../lib/content';
import { identity } from '../lib/identity';
import { compareByStartDescending, formatPeriod } from '../lib/period';

const { roles } = await loadContent();
const latestRole = [...roles].sort(compareByStartDescending)[0];
const repositories = [
  {
    name: 'cryptopay',
    url: 'https://github.com/thomazzi98/cryptopay',
    summary: 'Crypto payment processor with independent on-chain verification, built for Polygon.',
  },
  {
    name: 'whatsapp-notification-platform',
    url: 'https://github.com/thomazzi98/whatsapp-notification-platform',
    summary: 'Multi-tenant WhatsApp notification delivery platform.',
  },
  {
    name: 'mini-payment-gateway',
    url: 'https://github.com/thomazzi98/mini-payment-gateway',
    summary: 'API-first multi-tenant payment gateway with provider-agnostic Pix support.',
  },
];

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: identity.name,
  jobTitle: identity.headline,
  description: identity.summary,
  email: `mailto:${identity.email}`,
  url: Astro.site?.href,
  sameAs: [identity.links.github, identity.links.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: identity.city, addressCountry: 'BR' },
};
---

<Base title={`${identity.name} · ${identity.headline}`} description={identity.summary}>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema).replaceAll('<', '\\u003c')}
    />
  </Fragment>

  <section class="hero">
    <div>
      <p class="kicker">Backend engineer · payments, messaging and chain infrastructure</p>
      <h1 class="hero__name">{identity.name}</h1>
      <p class="hero__thesis">Systems that can say what happened, and prove it.</p>
    </div>
    <div class="hero__aside">
      <p>
        Three self-hosted systems, each built to <strong
          >determine what actually happened under uncertainty and to refuse to guess</strong
        >: finality gates and reorg-checked windows, outcomes classified by whether anything was
        created, acknowledgements merged by maximum, idempotency claims the database serialises.
      </p>
      <p class="hero__meta">
        <span>{identity.location}</span>
        <span>{identity.timezone}</span>
        {
          latestRole !== undefined && (
            <span>
              last role {latestRole.data.company} · {formatPeriod(latestRole.data.period)}
            </span>
          )
        }
        <a href="/resume.txt">resume.txt</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="systems-title">
    <div class="section__head">
      <h2 id="systems-title">Systems</h2>
      <p class="kicker">Three public repositories</p>
    </div>
    <ul class="repositories">
      {
        repositories.map((repository) => (
          <li>
            <a href={repository.url} class="mono">
              thomazzi98/{repository.name}
            </a>
            <span class="muted">{repository.summary}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
