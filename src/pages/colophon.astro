---
import { getCollection, render } from 'astro:content';
import lighthouseConfig from '../../lighthouserc.json';
import Base from '../layouts/Base.astro';
import { readBudgets } from '../lib/budgets';
import { buildInfo } from '../lib/build-info';
import { identity } from '../lib/identity';
import { systems } from '../systems';
import { shortCommit } from '../systems/evidence';

const decisions = (await getCollection('decisions')).sort((first, second) =>
  second.id.localeCompare(first.id),
);
const renderedDecisions = await Promise.all(
  decisions.map(async (decision) => ({
    decision,
    number: decision.id.slice(0, 4),
    Content: (await render(decision)).Content,
  })),
);
const budgets = readBudgets(lighthouseConfig);
const budgetGroups = [...new Set(budgets.map((budget) => budget.scope))].map((scope) => ({
  scope,
  budgets: budgets.filter((budget) => budget.scope === scope),
}));
const repository = buildInfo.repositoryUrl;
const workflow = `${repository}/actions/workflows/ci.yml`;
const recordUrl = (id: string) => `${repository}/blob/main/docs/decisions/${id}.md`;
const pipeline = [
  {
    name: 'Check out the sources',
    detail:
      'The three repositories are cloned at the commits the models pin; a pinned commit that is not on GitHub stops the build here.',
  },
  {
    name: 'Type check, lint, format, drafts',
    detail:
      'astro check over pages, islands and tests; ESLint with no else, no abbreviated identifiers and exhaustive switches; Prettier; a scan for draft markers and control characters.',
  },
  {
    name: 'Unit tests',
    detail:
      'Model integrity, evidence against the pinned checkouts, repository facts against git, trace determinism, layout, the text projections and the content integrity rules.',
  },
  {
    name: 'Build and check links',
    detail:
      'Static output for every route, then every internal href and fragment in the built HTML is resolved against the files that exist.',
  },
  {
    name: 'End to end with axe',
    detail:
      'Playwright over every route in the sitemap, on desktop Chrome, on a Pixel 7 profile and with JavaScript disabled, scanned for WCAG violations.',
  },
  {
    name: 'Lighthouse budgets',
    detail: 'The budgets below, asserted on the built pages. A failure blocks the deploy.',
  },
];
---

<Base
  title="Colophon · Rafael Thomazzi"
  description="How this site is built and verified: static Astro pages, Preact islands, a deterministic trace kernel and evidence checked against pinned commits."
>
  <section class="page-head">
    <p class="kicker">Colophon</p>
    <h1>How this is made</h1>
    <p class="lead muted">
      A static site that shows three systems as engineering. Everything on this page can be checked
      in the <a href={repository}>repository</a>.
    </p>
  </section>

  <section class="section" aria-labelledby="build-title">
    <div class="section__head">
      <h2 id="build-title">How it is built</h2>
      <p class="kicker">Astro 7 · Preact islands · a virtual clock</p>
      <p class="section__note">Evidence at a pinned commit, checked by the build.</p>
    </div>
    <div class="prose">
      <p>
        Astro 7 renders every page to static HTML at build time and GitHub Pages serves the files.
        The interactive parts, the schematic with its inspector, the flow player and the board on
        the home page, are Preact islands with signals for state. They hydrate when they scroll into
        view, and the schematic, the ledger and the transcript tables are already in the HTML before
        any script runs, so the system pages read the same with JavaScript disabled; the board on
        the home page says so and points there.
      </p>
      <p>
        Each system is a typed model under <code>src/systems</code>: repository, maturity, stack,
        nodes, edges, flows, state machines, decisions, code fragments, verification, security
        controls and limitations, validated by a Zod schema. Every entry carries evidence, a path
        and a line range at a pinned commit, and the schema does not accept an entry without it. The
        continuous integration checks out the three repositories at those commits and the unit suite
        reads every cited file with <code>git show</code>, fails on a file that does not exist or a
        line range past the end of the file, and compares every code fragment byte for byte with the
        original. The commit counts and dates the models state are checked against git by the same
        suite.
      </p>
      <p>
        Flows are replayed by a deterministic kernel under <code>src/trace/kernel</code>: a
        scheduler and a simulation on a virtual clock. A runner turns a flow and the lever values
        into scheduled steps; the same runner produces the transcript tables at build time and the <code
          >/systems/&lt;id&gt;.json</code
        > files, so the player, the table and the data agree because they are one computation. Under reduced
        motion nothing moves until Step.
      </p>
      <p>
        The person is content too. Roles, education and practices are collections validated with
        Zod; technologies are a registry that roles and systems cite by id. A reference to an
        unknown id fails the build, and so does a registry entry that nothing cites. A practice
        names the systems and roles that back it, and the build fails if it names one that does not
        exist. <a href="/resume.txt">resume.txt</a> and <a href="/llms.txt">llms.txt</a> are projections
        of the same data, computed once.
      </p>
      <p>
        Type is Instrument Serif for the human voice and IBM Plex Sans and IBM Plex Mono for the
        instruments, four self-hosted files. Colour means state and nothing else: green for
        committed, amber for waiting and for focus, red for a fault, violet for the outcome nobody
        knows yet.
      </p>
    </div>
    <table class="facts colophon-pins">
      <caption class="kicker">Pinned commits this build describes</caption>
      <tbody>
        {
          systems.map((system) => (
            <tr>
              <th scope="row">{system.name}</th>
              <td>
                <a href={`/systems/${system.id}/`}>{system.repository.name}</a> at{' '}
                {shortCommit(system.repository)}, {system.repository.pinnedOn}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>

  <section class="section" aria-labelledby="refuses-title">
    <div class="section__head">
      <h2 id="refuses-title">What the build refuses</h2>
      <p class="kicker">Every push runs the <a href={workflow}>same pipeline</a></p>
    </div>
    <ol class="colophon-pipeline">
      {
        pipeline.map((stage) => (
          <li>
            <span>
              <strong>{stage.name}</strong> <span class="muted">{stage.detail}</span>
            </span>
          </li>
        ))
      }
    </ol>
    {
      budgetGroups.map((group) => (
        <table class="facts budgets">
          <caption class="kicker">Lighthouse budgets · {group.scope}</caption>
          <thead>
            <tr>
              <th scope="col">Audit</th>
              <th scope="col">Budget</th>
            </tr>
          </thead>
          <tbody>
            {group.budgets.map((budget) => (
              <tr>
                <th scope="row">{budget.audit}</th>
                <td>{budget.threshold}</td>
              </tr>
            ))}
          </tbody>
        </table>
      ))
    }
  </section>

  <section class="section" aria-labelledby="records-title">
    <div class="section__head">
      <h2 id="records-title">Decision records</h2>
      <p class="kicker">Newest first</p>
      <p class="section__note">Superseded records are kept as written.</p>
    </div>
    <div class="decisions colophon-records">
      {
        renderedDecisions.map(({ decision, number, Content }) => (
          <article class="decision" id={`decision-${number}`}>
            <h3>
              <span class="mono muted">{number}</span> {decision.data.title}
            </h3>
            <p class="kicker">
              <span
                class="badge"
                data-tone={decision.data.status === 'accepted' ? 'ok' : 'neutral'}
              >
                {decision.data.status}
              </span>{' '}
              · {decision.data.date.toISOString().slice(0, 10)} ·{' '}
              <a href={recordUrl(decision.id)}>record {number}</a>
            </p>
            {decision.data.status === 'accepted' && (
              <div class="prose">
                <Content />
              </div>
            )}
            {decision.data.status !== 'accepted' && (
              <details>
                <summary>Read the record as it was written</summary>
                <div class="prose">
                  <Content />
                </div>
              </details>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="stamp-title">
    <div class="section__head">
      <h2 id="stamp-title">This build</h2>
    </div>
    <p class="colophon-stamp">
      <span>
        commit <a href={`${repository}/commit/${buildInfo.commit}`}>{buildInfo.commit}</a> · {
          buildInfo.date
        }
      </span>
      {
        buildInfo.runUrl !== undefined && (
          <span>
            <a href={buildInfo.runUrl}>workflow run</a>
          </span>
        )
      }
      <span>no analytics, no cookies, no third-party requests</span>
      <span>
        {identity.name}, {identity.location}
      </span>
    </p>
  </section>
</Base>
