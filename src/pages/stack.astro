---
import Base from '../layouts/Base.astro';
import { loadContent } from '../lib/content';
import { indexEvidence } from '../lib/evidence';
import { technologyGroups } from '../content/schemas';
import { selectGroup, technologyGroupLabels, type TechnologyGroup } from '../lib/technology-groups';

const { roles, projects, technologies } = await loadContent();
const evidence = indexEvidence(roles, projects);

const definitions: Record<TechnologyGroup, string> = {
  'owned-in-production':
    'I designed or owned a production service built on it and supported it after release.',
  'shipped-with': 'Used in production code I contributed to, without owning that layer’s design.',
  familiar:
    'A personal project, a proof of concept or an early role. I would need ramp-up before claiming ownership.',
};

const groups = technologyGroups.map((group) => ({
  group,
  heading: technologyGroupLabels[group],
  definition: definitions[group],
  entries: selectGroup(technologies, group),
}));
---

<Base
  title="Stack · Rafael Thomazzi"
  description="Technologies grouped by the claim I can back: owned in production, shipped with, or familiar. Every entry lists the roles and case studies behind it."
>
  <section class="page-head">
    <h1>The warp</h1>
    <p class="measure muted">
      Every thread on the cloth, grouped by the claim I can back. Each entry lists the roles and
      case studies behind it; a technology with nothing behind it cannot be listed, because the
      build refuses it.
    </p>
  </section>

  {
    groups.map(({ group, heading, definition, entries }) => (
      <section class="section" aria-labelledby={group} data-group={group}>
        <div class="section__head">
          <h2 id={group}>
            <span class="cloth-key" data-group={group} aria-hidden="true" /> {heading}
          </h2>
          <p class="kicker">{entries.length} threads</p>
        </div>
        <p class="measure muted stack-definition">{definition}</p>
        <table class="stack-table" role="table">
          <thead role="rowgroup">
            <tr role="row">
              <th role="columnheader" scope="col">
                Technology
              </th>
              <th role="columnheader" scope="col">
                Category
              </th>
              <th role="columnheader" scope="col">
                Since
              </th>
              <th role="columnheader" scope="col">
                Evidence
              </th>
            </tr>
          </thead>
          <tbody role="rowgroup">
            {entries.map((technology) => (
              <tr role="row" id={technology.id}>
                <th role="rowheader" scope="row">
                  {technology.data.name}
                </th>
                <td role="cell" class="muted">
                  {technology.data.category}
                </td>
                <td role="cell" class="muted">
                  {technology.data.firstUsed}
                </td>
                <td role="cell">
                  {[
                    ...evidence.rolesFor(technology.id).map((role) => ({
                      label: role.data.company,
                      href: undefined,
                    })),
                    ...evidence.projectsFor(technology.id).map((project) => ({
                      label: project.data.title,
                      href: `/work/${project.id}/`,
                    })),
                  ].map((item, index) => (
                    <span>
                      {index > 0 && ' · '}
                      {item.href === undefined ? (
                        <span class="muted">{item.label}</span>
                      ) : (
                        <a href={item.href}>{item.label}</a>
                      )}
                    </span>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }
</Base>
