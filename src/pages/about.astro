---
import { render } from 'astro:content';
import Cloth from '../components/Cloth.astro';
import Base from '../layouts/Base.astro';
import { buildInfo } from '../lib/build-info';
import { weaveCloth } from '../lib/cloth';
import { loadContent } from '../lib/content';
import { identity } from '../lib/identity';
import { sortPracticesByTie } from '../lib/practices';
import { selectCaseStudies } from '../lib/projects';
import { compareByStartDescending, formatPeriod } from '../lib/period';
import { createTechnologyNameLookup } from '../lib/technologies';

const { roles, projects, technologies, education, practices } = await loadContent();
const technologyName = createTechnologyNameLookup(technologies);
const cloth = weaveCloth({ roles, projects, technologies, now: buildInfo.yearMonth });
const rolesByRecency = [...roles].sort(compareByStartDescending);
const renderedRoles = await Promise.all(
  rolesByRecency.map(async (role) => ({ role, Content: (await render(role)).Content })),
);
const educationByRecency = [...education].sort(
  (first, second) => second.data.year - first.data.year,
);
const orderedPractices = sortPracticesByTie(practices, selectCaseStudies(projects));
const projectTitle = (id: string) =>
  projects.find((project) => project.id === id)?.data.title ?? id;
const firstPick = cloth.picks[0] ?? '';
const wovenMonths = cloth.cells.reduce(
  (total, row) => total + row.filter((cell) => cell !== 0).length,
  0,
);
---

<Base
  title="About · Rafael Thomazzi"
  description="The career woven month by month from the same files that generate the resume, the practices I work by and the cases that back them, and where I studied."
>
  <section class="page-head">
    <h1>The whole cloth</h1>
    <p class="measure muted">
      Sorocaba, where I studied and started, was once called the Manchester Paulista for its textile
      mills. The work I do is the weft between fixed systems, so here is the career as a weaving
      draft: every technology in the registry is a warp thread, every month from {firstPick} on is a pick,
      and a cell is woven when a role used that thread that month. A darker float marks a case study.
      Where two roles overlap, the treadle row doubles.
    </p>
  </section>

  <a href="#career-title" class="skip-cloth mono">Skip the cloth</a>
  <figure class="cloth-figure">
    <Cloth cloth={cloth} roles={roles} orientation="horizontal" />
    <Cloth cloth={cloth} roles={roles} orientation="vertical" />
    <figcaption class="cloth-figure__caption mono">
      <span
        >{cloth.threads.length} threads · {cloth.picks.length} picks · {wovenMonths} woven cells</span
      >
      <span>
        <span class="cloth-key" data-group="owned-in-production"></span> owned in production
        <span class="cloth-key" data-group="shipped-with"></span> shipped with
        <span class="cloth-key" data-group="familiar"></span> familiar
        <span class="cloth-key" data-weave="float"></span> case study
      </span>
      <span>
        Projected at build from the role and project files · <a href="/draft.json">draft.json</a>
      </span>
    </figcaption>
  </figure>

  <section class="section" aria-labelledby="career-title">
    <div class="section__head">
      <h2 id="career-title">The roles, in order</h2>
      <p class="kicker">Most recent first</p>
    </div>
    <div class="roles">
      {
        renderedRoles.map(({ role, Content }) => (
          <article class="role">
            <header class="role__head mono">
              <h3>{role.data.company}</h3>
              <p class="muted">{role.data.companyGloss}</p>
              <p>{role.data.title}</p>
              <p class="muted">
                {formatPeriod(role.data.period)} · {role.data.location}
              </p>
              <p class="muted role__stack">{role.data.stack.map(technologyName).join(' · ')}</p>
            </header>
            <div class="prose">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="practices-title">
    <div class="section__head">
      <h2 id="practices-title">How I work</h2>
      <p class="kicker">Each claim names the work that backs it</p>
    </div>
    <ol class="practices">
      {
        orderedPractices.map((practice) => (
          <li class="practice">
            <p class="practice__claim">{practice.data.claim}</p>
            <p class="practice__backing mono">
              {practice.data.backedBy.map((reference, index) => (
                <>
                  {index > 0 && <span aria-hidden="true"> · </span>}
                  <a href={`/work/${reference.id}/`}>{projectTitle(reference.id)}</a>
                </>
              ))}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" aria-labelledby="education-title">
    <div class="section__head">
      <h2 id="education-title">Education</h2>
      <p class="kicker">Glossed for readers outside Brazil</p>
    </div>
    <ul class="education">
      {
        educationByRecency.map(({ data }) => (
          <li>
            <span>
              {data.credential}, {data.field}
            </span>
            <span class="muted mono">
              {data.institution} · {data.year}
            </span>
            <span class="muted">
              {data.credentialGloss} · {data.institutionGloss}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="read-side-title">
    <div class="section__head">
      <h2 id="read-side-title">Write side, read side</h2>
      <p class="kicker">The site practices its own case</p>
    </div>
    <p class="measure">
      The roles above are markdown files with typed front matter. The cloth, the resume, the
      llms.txt file and the stack page are projections of them, computed once at build and served as
      static files. Nothing on a page reads the source documents at request time, which is the same
      shape as the read-model bench: write once, project for each reader. The projection for this
      page is at <a href="/draft.json">/draft.json</a>, and the resume it agrees with is at
      <a href="/resume.txt">/resume.txt</a>.
    </p>
    <p class="measure muted">
      {identity.location} · {identity.timezone} · {identity.availability}.
    </p>
  </section>
</Base>
