---
import { Font } from 'astro:assets';
import { CommandPalette } from '../islands/palette/CommandPalette';
import { buildInfo } from '../lib/build-info';
import { identity } from '../lib/identity';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  indexable?: boolean;
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  indexable = true,
  image = '/og.png',
  imageAlt = 'Systems that can say what happened, and prove it.',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const navigation = [
  { href: '/systems/', label: 'Systems' },
  { href: '/architecture/', label: 'Architecture' },
  { href: '/demo/', label: 'Live' },
  { href: '/decisions/', label: 'Decisions' },
  { href: '/about/', label: 'About' },
  { href: '/colophon/', label: 'Colophon' },
];
const currentState = (href: string): 'page' | 'true' | undefined => {
  if (Astro.url.pathname === href) {
    return 'page';
  }
  return Astro.url.pathname.startsWith(href) ? 'true' : undefined;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    {!indexable && <meta name="robots" content="noindex" />}
    {indexable && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121416" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f2ea" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexable && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <Font cssVariable="--font-instrument-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" preload />
    <noscript>
      <style>
        .player__rail,
        .player__levers,
        .player__flows,
        .player .ledger,
        .board__rail,
        .board__ledger,
        .board__flow,
        .map__lenses,
        .palette__trigger,
        .machine__statuses,
        .machine__reading,
        .machine__key,
        .explorer__inspector {
          display: none;
        }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="shell">
      <div class="site-header">
        <a href="/" class="wordmark">{identity.name}</a>
        <nav aria-label="Primary" class="site-nav">
          {
            navigation.map(({ href, label }) => (
              <a href={href} aria-current={currentState(href)}>
                {label}
              </a>
            ))
          }
        </nav>
        <CommandPalette client:idle />
      </div>
    </header>
    <main id="main" tabindex="-1" class="shell">
      <slot />
    </main>
    <footer class="shell site-footer">
      <dl class="site-footer__list">
        <div>
          <dt>Location</dt>
          <dd>{identity.location}</dd>
          <dd>{identity.timezone} · {identity.availability}</dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${identity.email}`}>{identity.email}</a></dd>
        </div>
        <div>
          <dt>Elsewhere</dt>
          <dd><a href={identity.links.github}>github.com/thomazzi98</a></dd>
          <dd><a href={identity.links.linkedin}>LinkedIn</a></dd>
          <dd><a href="/resume.txt">resume.txt</a></dd>
        </div>
      </dl>
      <p class="site-footer__note">
        Build <a href="/colophon/">{buildInfo.commit} · {buildInfo.date}</a>. No analytics, no
        cookies, no third-party requests.
      </p>
    </footer>
    <script>
      import { announceInConsole } from '../lib/console-banner';

      announceInConsole();
    </script>
  </body>
</html>
