---
import { Font } from 'astro:assets';
import { CommandPalette } from '../islands/palette/CommandPalette';
import { buildInfo } from '../lib/build-info';
import { identity } from '../lib/identity';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  { href: '/systems/', label: 'Systems' },
  { href: '/architecture/', label: 'Architecture' },
  { href: '/decisions/', label: 'Decisions' },
  { href: '/about/', label: 'About' },
  { href: '/colophon/', label: 'Colophon' },
];
const currentState = (href: string): 'page' | 'true' | undefined => {
  if (Astro.url.pathname === href) {
    return 'page';
  }
  return Astro.url.pathname.startsWith(href) ? 'true' : undefined;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#121416" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f2ea" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={identity.positioning} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-instrument-serif" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" preload={[{ weight: 400 }]} />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <header class="shell">
      <div class="site-header">
        <a href="/" class="wordmark">{identity.name}</a>
        <nav aria-label="Primary" class="site-nav">
          {
            navigation.map(({ href, label }) => (
              <a href={href} aria-current={currentState(href)}>
                {label}
              </a>
            ))
          }
        </nav>
        <CommandPalette client:idle />
      </div>
    </header>
    <main id="main" tabindex="-1" class="shell">
      <slot />
    </main>
    <footer class="shell">
      <dl class="site-footer">
        <div>
          <dt>Location</dt>
          <dd>{identity.location}</dd>
          <dd>{identity.timezone} · {identity.availability}</dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${identity.email}`}>{identity.email}</a></dd>
        </div>
        <div>
          <dt>Elsewhere</dt>
          <dd><a href={identity.links.github}>github.com/thomazzi98</a></dd>
          <dd><a href={identity.links.linkedin}>LinkedIn</a></dd>
          <dd><a href="/resume.txt">resume.txt</a></dd>
        </div>
        <p class="site-footer__note">
          Build <a href="/colophon/">{buildInfo.commit} · {buildInfo.date}</a>. No analytics, no
          cookies, no third-party requests.
        </p>
      </dl>
    </footer>
    <script>
      import { announceInConsole } from '../lib/console-banner';

      announceInConsole();
    </script>
  </body>
</html>
