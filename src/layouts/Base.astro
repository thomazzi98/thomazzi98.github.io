---
import { Font } from 'astro:assets';
import { buildInfo } from '../lib/build-info';
import { identity } from '../lib/identity';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const navigation = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/stack/', label: 'Stack' },
  { href: '/colophon/', label: 'Colophon' },
];
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
const contacts = [
  { href: `mailto:${identity.email}`, label: identity.email },
  { href: identity.links.github, label: 'GitHub' },
  { href: identity.links.linkedin, label: 'LinkedIn' },
  { href: '/resume.txt', label: 'resume.txt' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f6" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111213" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={identity.positioning} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-plex-sans" preload />
    <Font cssVariable="--font-plex-mono" preload={[{ weight: 400 }]} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-10 focus:bg-accent focus:px-3 focus:py-2 focus:text-accent-ink focus:no-underline"
    >
      Skip to content
    </a>
    <header class="border-b border-rule">
      <div
        class="mx-auto flex max-w-(--container) flex-wrap items-baseline justify-between gap-x-6 gap-y-1 px-(--gutter) py-4 font-mono text-xs tracking-label uppercase"
      >
        <a href="/" class="shrink-0 text-sm no-underline">{identity.name}</a>
        <nav aria-label="Primary" class="flex flex-wrap gap-x-5 gap-y-1">
          {
            navigation.map(({ href, label }) => (
              <a
                href={href}
                aria-current={isCurrent(href) ? 'page' : undefined}
                class="text-ink-muted no-underline underline-offset-4 hover:text-ink aria-[current=page]:text-ink aria-[current=page]:underline"
              >
                {label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class="mx-auto w-full max-w-(--container) flex-1 px-(--gutter)">
      <slot />
    </main>
    <footer class="border-t border-rule">
      <div
        class="mx-auto flex max-w-(--container) flex-wrap justify-between gap-x-6 gap-y-2 px-(--gutter) py-6 font-mono text-xs text-ink-muted"
      >
        <span>
          {identity.location} · {identity.timezone} ·{' '}
          <a href="/colophon/">build {buildInfo.commit} · {buildInfo.date}</a>
        </span>
        <span>
          {
            contacts.map(({ href, label }, index) => (
              <>
                {index > 0 && <span aria-hidden="true"> · </span>}
                <a href={href}>{label}</a>
              </>
            ))
          }
        </span>
      </div>
    </footer>
  </body>
</html>
