---
import type { CollectionEntry } from 'astro:content';
import { type Cloth, wovenByCaseStudy, wovenByRole } from '../lib/cloth';
import { compareByStartDescending } from '../lib/period';

interface Props {
  cloth: Cloth;
  roles: CollectionEntry<'roles'>[];
  orientation: 'horizontal' | 'vertical';
}

const { cloth, roles, orientation } = Astro.props;
const horizontal = orientation === 'horizontal';
const cellAlongTime = horizontal ? 8 : 7;
const cellAcrossThreads = horizontal ? 11 : 10;
const labelSpace = horizontal ? 118 : 96;
const bandSpace = 38;
const yearSpace = 14;
const treadleSpace = 16;
const headSpace = bandSpace + yearSpace;
const timeLength = cloth.picks.length * cellAlongTime;
const threadLength = cloth.threads.length * cellAcrossThreads;
const width = horizontal ? labelSpace + timeLength : labelSpace + threadLength;
const height = horizontal
  ? headSpace + threadLength + treadleSpace
  : headSpace + timeLength + treadleSpace;

const pickIndex = new Map(cloth.picks.map((pick, index) => [pick, index]));
const bands = [...roles].sort(compareByStartDescending).reverse();
const laneOf = new Map<string, number>();
const laneEnds: number[] = [];
for (const role of bands) {
  const start = pickIndex.get(role.data.period.start) ?? 0;
  const end =
    pickIndex.get(role.data.period.end ?? cloth.picks.at(-1) ?? '') ?? cloth.picks.length - 1;
  let lane = laneEnds.findIndex((laneEnd) => laneEnd < start);
  if (lane === -1) {
    lane = laneEnds.length;
    laneEnds.push(end);
  }
  laneEnds[lane] = end;
  laneOf.set(role.id, lane);
}
const bandOf = (role: CollectionEntry<'roles'>) => {
  const start = pickIndex.get(role.data.period.start) ?? 0;
  const end =
    pickIndex.get(role.data.period.end ?? cloth.picks.at(-1) ?? '') ?? cloth.picks.length - 1;
  const lane = laneOf.get(role.id) ?? 0;
  return { start, end, lane };
};
const positionAlongTime = (pick: number) =>
  (horizontal ? labelSpace : headSpace) + pick * cellAlongTime;
const positionAcrossThreads = (thread: number) =>
  (horizontal ? headSpace : labelSpace) + thread * cellAcrossThreads;
const januaries = cloth.picks
  .map((pick, index) => ({ pick, index }))
  .filter(({ pick }) => pick.endsWith('-01'));
const monthsWoven = (row: number) => cloth.cells[row]?.filter((cell) => cell !== 0).length ?? 0;
const weaveName = (cell: number): string => {
  if (cell === wovenByCaseStudy) {
    return 'float';
  }
  return cell === wovenByRole ? 'role' : 'none';
};
const title = 'The career as a weaving draft';
const description = `Every technology in the registry is a warp thread; every month from ${cloth.picks[0] ?? ''} to ${cloth.picks.at(-1) ?? ''} is a pick. A cell is woven when a role used that technology that month, and marked as a float when a case study did. Where two roles overlap, the treadle row doubles.`;
---

<svg
  class="cloth"
  data-orientation={orientation}
  viewBox={`0 0 ${String(width)} ${String(height)}`}
  role="group"
  aria-labelledby={`cloth-${orientation}-title cloth-${orientation}-description`}
>
  <title id={`cloth-${orientation}-title`}>{title}</title>
  <desc id={`cloth-${orientation}-description`}>{description}</desc>

  <g class="cloth__bands">
    {
      bands.map((role) => {
        const band = bandOf(role);
        const from = positionAlongTime(band.start);
        const until = positionAlongTime(band.end + 1);
        const offset = band.lane * 12;
        return horizontal ? (
          <g>
            <rect x={from} y={offset} width={until - from} height="9" class="cloth__band" />
            <text x={from + 3} y={offset + 7} class="cloth__band-label">
              {role.data.company}
            </text>
          </g>
        ) : (
          <g>
            <rect x={offset} y={from} width="9" height={until - from} class="cloth__band" />
            <text
              x={offset + 7}
              y={from + 3}
              class="cloth__band-label"
              transform={`rotate(90 ${String(offset + 7)} ${String(from + 3)})`}
            >
              {role.data.company}
            </text>
          </g>
        );
      })
    }
  </g>

  <g class="cloth__years">
    {
      januaries.map(({ pick, index }) =>
        horizontal ? (
          <text x={positionAlongTime(index)} y={bandSpace + 10} class="cloth__year">
            {pick.slice(0, 4)}
          </text>
        ) : (
          <text
            x={bandSpace + 2}
            y={positionAlongTime(index) + 6}
            class="cloth__year"
            text-anchor="start"
          >
            {pick.slice(0, 4)}
          </text>
        ),
      )
    }
  </g>

  <g class="cloth__threads">
    {
      cloth.threads.map((thread, row) => {
        const across = positionAcrossThreads(row);
        const label = `${thread.name} · ${String(monthsWoven(row))} months`;
        return (
          <a
            href={`/stack/#${thread.id}`}
            class="cloth__thread"
            data-group={thread.group}
            aria-label={label}
          >
            <title>{label}</title>
            {horizontal ? (
              <line
                x1={labelSpace}
                y1={across + cellAcrossThreads / 2}
                x2={width}
                y2={across + cellAcrossThreads / 2}
                class="cloth__warp"
              />
            ) : (
              <line
                x1={across + cellAcrossThreads / 2}
                y1={headSpace}
                x2={across + cellAcrossThreads / 2}
                y2={height - treadleSpace}
                class="cloth__warp"
              />
            )}
            {horizontal ? (
              <text
                x={labelSpace - 6}
                y={across + cellAcrossThreads - 3}
                text-anchor="end"
                class="cloth__label"
              >
                {thread.name}
              </text>
            ) : (
              <text
                x={across + cellAcrossThreads - 2}
                y={labelSpace - 4}
                text-anchor="end"
                class="cloth__label"
                transform={`rotate(-90 ${String(across + cellAcrossThreads - 2)} ${String(labelSpace - 4)})`}
              >
                {thread.name}
              </text>
            )}
            {cloth.cells[row]?.map((cell, column) =>
              cell === 0 ? null : (
                <rect
                  x={horizontal ? positionAlongTime(column) : across + 1}
                  y={horizontal ? across + 1 : positionAlongTime(column)}
                  width={horizontal ? cellAlongTime - 1 : cellAcrossThreads - 2}
                  height={horizontal ? cellAcrossThreads - 2 : cellAlongTime - 1}
                  class="cloth__cell"
                  data-weave={weaveName(cell)}
                />
              ),
            )}
          </a>
        );
      })
    }
  </g>

  <g class="cloth__treadles">
    {
      cloth.treadles.map((count, column) =>
        [...Array(count).keys()].map((lane) => (
          <rect
            x={
              horizontal ? positionAlongTime(column) + 1 : labelSpace + threadLength + 2 + lane * 5
            }
            y={horizontal ? height - treadleSpace + 3 + lane * 5 : positionAlongTime(column) + 1}
            width={horizontal ? cellAlongTime - 2 : 4}
            height={horizontal ? 4 : cellAlongTime - 2}
            class="cloth__treadle"
          />
        )),
      )
    }
  </g>
</svg>
