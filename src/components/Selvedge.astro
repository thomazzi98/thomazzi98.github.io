---
import type { CollectionEntry } from 'astro:content';
import { compareByFirstUsedThenName } from '../lib/technology-groups';

interface Props {
  technologies: CollectionEntry<'technologies'>[];
}

const { technologies } = Astro.props;
const threads = [...technologies].sort(compareByFirstUsedThenName);
const threadWidth = 8;
const rows = 3;
const rowHeight = 3;
const width = threads.length * threadWidth;
const height = rows * rowHeight;
const colorFor = {
  'owned-in-production': 'var(--indigo)',
  'shipped-with': 'var(--madder)',
  familiar: 'var(--greige)',
};
---

<svg
  class="selvedge"
  viewBox={`0 0 ${String(width)} ${String(height)}`}
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  {
    threads.flatMap((thread, column) =>
      [...Array(rows).keys()].map((row) =>
        (column + row) % 2 === 0 ? (
          <rect
            x={column * threadWidth}
            y={row * rowHeight}
            width={threadWidth}
            height={rowHeight}
            fill={colorFor[thread.data.group]}
          />
        ) : null,
      ),
    )
  }
</svg>
