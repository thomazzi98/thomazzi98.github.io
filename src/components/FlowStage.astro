---
import { FlowPlayer } from '../islands/player/FlowPlayer';
import { formatClock } from '../islands/player/format';
import { footprintOf } from '../systems/board';
import EvidenceLinks from './EvidenceLinks.astro';
import { edgeEndpoints, toSchematicEdges, toSchematicNodes } from '../systems/presentation';
import type { Flow, SystemModel } from '../systems/schema';
import { defaultLeverValues, runTranscript } from '../trace/runner';

interface Props {
  system: SystemModel;
  flows: Flow[];
  autoplay?: boolean;
}

const { system, flows, autoplay = false } = Astro.props;
const { repository } = system;
// A page mounts one stage per group of flow kinds, so the first kind tells the stages apart;
// the player needs that to keep its radio groups and drawing ids to itself.
const stageId = `${system.id}-${flows[0]?.kind ?? 'stage'}`;
// A stage draws the parts its flows touch, not the whole system, so the path stays legible;
// the architecture section is where the whole system is drawn.
const footprint = new Set(flows.flatMap((flow) => [...footprintOf(system, flow)]));
const nodes = toSchematicNodes(system.nodes.filter((node) => footprint.has(node.id)));
const edges = toSchematicEdges(
  system.edges.filter((edge) => footprint.has(edge.from) && footprint.has(edge.to)),
);
// The player needs the steps, not the citations behind them; those stay on the page.
const playerFlows = flows.map((flow) => ({
  ...flow,
  assertedBy: [],
  steps: flow.steps.map((step) => ({ ...step, evidence: [] })),
}));
const endpoints = edgeEndpoints(system.edges);
const labels = new Map<string, string>([
  ...system.nodes.map((node) => [node.id, node.label] as const),
  ...system.edges.map((edge) => [edge.id, edge.label] as const),
]);
const transcripts = flows.map((flow) => ({
  flow,
  entries: runTranscript(flow, endpoints, { levers: defaultLeverValues(flow.levers) }),
  defaults: flow.levers.map((lever) => {
    const option = lever.options.find((candidate) => candidate.value === lever.defaultValue);
    return `${lever.label}: ${option?.label ?? lever.defaultValue}`;
  }),
}));
---

<div class="stage" data-flows={flows.map((flow) => flow.id).join(' ')}>
  <FlowPlayer
    client:visible
    stageId={stageId}
    systemId={system.id}
    systemName={system.shortName}
    nodes={nodes}
    edges={edges}
    flows={playerFlows}
    autoplay={autoplay}
  />
  <noscript>
    <p class="stage__note">
      Without JavaScript the replays do not run; the transcripts below are complete.
    </p>
  </noscript>
  <div class="transcripts">
    {
      transcripts.map(({ flow, entries, defaults }) => (
        <details class="transcript" id={`transcript-${flow.id}`} open>
          <summary>
            <span class="transcript__name">{flow.name}</span>
            <span class="kicker">
              {' '}
              · transcript{defaults.length > 0 ? ` · ${defaults.join(' · ')}` : ''}
            </span>
          </summary>
          <p class="transcript__summary muted">{flow.summary}</p>
          <div
            class="transcript__scroll"
            role="region"
            tabindex="0"
            aria-label={`${flow.name} transcript, scrolls sideways`}
          >
            <table class="transcript__table">
              <caption class="sr-only">{flow.name}, replayed with the default levers</caption>
              <thead>
                <tr>
                  <th scope="col">Clock</th>
                  <th scope="col">Where</th>
                  <th scope="col">What happened</th>
                </tr>
              </thead>
              <tbody>
                {entries.map((entry) => (
                  <tr data-tone={entry.tone}>
                    <td class="mono">{formatClock(entry.at)}</td>
                    <td>{labels.get(entry.station) ?? entry.station}</td>
                    <td>{entry.message}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {flow.assertedBy.length > 0 && (
            <p class="transcript__asserted evidence">
              Asserted by <EvidenceLinks repository={repository} evidence={flow.assertedBy} />
            </p>
          )}
        </details>
      ))
    }
  </div>
  <script is:inline>
    {
      const stage = document.currentScript.parentElement;
      for (const transcript of stage.querySelectorAll('details.transcript')) {
        transcript.removeAttribute('open');
      }
      // The player hydrates once it is in view, so a hash naming one of this stage's flows brings
      // it there first; the player then selects the flow and restarts.
      const flowIds = stage.dataset.flows.split(' ');
      const bringPlayer = () => {
        if (!flowIds.includes(window.location.hash.replace(/^#flow-/, ''))) {
          return;
        }
        stage.querySelector('.player')?.scrollIntoView({ block: 'start' });
      };
      bringPlayer();
      window.addEventListener('hashchange', bringPlayer);
    }
  </script>
</div>
