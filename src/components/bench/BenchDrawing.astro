---
import { pointAlong, wirePath, type Layout } from '../../bench/render/layout';

interface Props {
  layout: Layout;
  title: string;
  description: string;
}

const { layout, title, description } = Astro.props;
const uid = `${layout.orientation}-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const arrow = `arrow-${uid}`;
const hatch = `hatch-${uid}`;
---

<svg
  viewBox={`0 0 ${String(layout.width)} ${String(layout.height)}`}
  role="img"
  aria-labelledby={`${uid}-title ${uid}-description`}
  class="drawing"
  data-bench-drawing
  data-orientation={layout.orientation}
>
  <title id={`${uid}-title`}>{title}</title>
  <desc id={`${uid}-description`}>{description}</desc>
  <defs>
    <marker
      id={arrow}
      viewBox="0 0 8 8"
      refX="7"
      refY="4"
      markerWidth="7"
      markerHeight="7"
      orient="auto-start-reverse"
    >
      <path d="M0,0 L8,4 L0,8 z" class="drawing__arrow"></path>
    </marker>
    <pattern
      id={hatch}
      width="6"
      height="6"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <line x1="0" y1="0" x2="0" y2="6" class="drawing__hatch-line"></line>
    </pattern>
  </defs>
  <g class="drawing__wires">
    {
      layout.wires.map((placed, index) => {
        const middle = pointAlong(placed, 0.5);
        return (
          <g class="wire" data-dashed={placed.wire.dashed === true ? 'true' : undefined}>
            <path
              d={wirePath(placed)}
              data-wire-from={placed.wire.from}
              data-wire-to={placed.wire.to}
              data-wire-index={index}
              data-x1={placed.x1}
              data-y1={placed.y1}
              data-x2={placed.x2}
              data-y2={placed.y2}
              data-cx={placed.control?.x}
              data-cy={placed.control?.y}
              marker-end={`url(#${arrow})`}
            />
            {placed.wire.label !== undefined && (
              <text x={middle.x} y={middle.y - 5} text-anchor="middle" class="wire__label">
                {placed.wire.label}
              </text>
            )}
          </g>
        );
      })
    }
  </g>
  <g class="drawing__stations">
    {
      layout.stations.map((placed) => (
        <g
          data-station={placed.station.id}
          data-kind={placed.station.kind}
          data-tone="neutral"
          transform={`translate(${String(placed.x)} ${String(placed.y)})`}
        >
          <rect
            width={placed.width}
            height={placed.height}
            rx={placed.station.kind === 'actor' ? placed.height / 2 : 2}
            class="station__body"
            fill={placed.station.kind === 'external' ? `url(#${hatch})` : undefined}
          />
          {placed.station.kind === 'store' && (
            <line x1="0" y1="8" x2={placed.width} y2="8" class="station__detail" />
          )}
          {placed.station.kind === 'queue' &&
            [0.2, 0.4, 0.6, 0.8].map((share) => (
              <line
                x1={placed.width * share}
                y1="0"
                x2={placed.width * share}
                y2={placed.height}
                class="station__detail"
              />
            ))}
          <text
            x={placed.width / 2}
            y={placed.station.note === undefined ? placed.height / 2 + 4 : placed.height / 2 - 2}
            text-anchor="middle"
            class="station__label"
          >
            {placed.station.label}
          </text>
          {placed.station.note !== undefined && (
            <text
              x={placed.width / 2}
              y={placed.height / 2 + 12}
              text-anchor="middle"
              class="station__note"
            >
              {placed.station.note}
            </text>
          )}
          <g class="station__badge" transform={`translate(${String(placed.width - 2)} 2)`}>
            <text data-badge text-anchor="end" y="-3" />
          </g>
        </g>
      ))
    }
  </g>
  <g class="drawing__packets" data-packets></g>
</svg>
