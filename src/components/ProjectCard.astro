---
import type { CollectionEntry } from 'astro:content';
import { formatPeriod } from '../lib/period';
import type { TechnologyName } from '../lib/technologies';
import StatusLabel from './StatusLabel.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  company: string | undefined;
  technologyName: TechnologyName;
}

const { project, company, technologyName } = Astro.props;
const { title, tagline, status, period, stack } = project.data;
---

<article class="border-t border-rule py-6">
  <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-ink-muted">
    {company && <span>{company}</span>}
    <span>{formatPeriod(period)}</span>
    <StatusLabel status={status} />
  </p>
  <h3 class="mt-3 text-fluid-lg leading-snug font-semibold tracking-tight">
    <a
      href={`/work/${project.id}/`}
      class="underline decoration-ink-muted decoration-1 underline-offset-[0.2em] hover:decoration-accent"
    >
      {title}
    </a>
  </h3>
  <p class="mt-2 max-w-(--measure) text-ink-muted">{tagline}</p>
  <p class="mt-3 font-mono text-xs text-ink-muted">{stack.map(technologyName).join(' · ')}</p>
</article>
