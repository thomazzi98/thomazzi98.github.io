---
import { evidenceLabel, evidenceUrl } from '../systems/evidence';
import type { Evidence, Repository } from '../systems/schema';

interface Props {
  repository: Repository;
  evidence: readonly Evidence[];
}

const { repository, evidence } = Astro.props;
// A path may break after a slash or before a dot, never inside a name, so a wrapped label still reads as a path.
const segments = (label: string): string[] => label.split(/(?<=\/)|(?=\.)/);
const links = evidence.map((entry) => ({
  href: evidenceUrl(repository, entry),
  segments: segments(evidenceLabel(entry)),
}));
---

{
  links.map((link, index) => (
    <Fragment>
      {index > 0 && ' · '}
      <a class="evidence-link" href={link.href}>
        {link.segments.map((segment, position) => (
          <Fragment>
            {position > 0 && <wbr />}
            {segment}
          </Fragment>
        ))}
      </a>
    </Fragment>
  ))
}
