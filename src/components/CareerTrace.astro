---
import type { CollectionEntry } from 'astro:content';
import { formatPeriod } from '../lib/period';
import { buildTrace } from '../lib/trace';

interface Props {
  roles: CollectionEntry<'roles'>[];
  now: string;
}

const { roles, now } = Astro.props;
const trace = buildTrace(roles, now);
const roleById = new Map(roles.map((role) => [role.id, role]));
const spans = trace.spans.flatMap((span) => {
  const role = roleById.get(span.id);
  return role === undefined ? [] : [{ span, role }];
});
---

<figure class="trace" style={`--months: ${String(trace.totalMonths)}`}>
  <figcaption class="font-mono text-xs tracking-label text-ink-muted uppercase">
    Career trace · {trace.origin} → {now}
  </figcaption>
  <div class="trace-axis" aria-hidden="true">
    {
      trace.years.map((year) => (
        <span class="trace-tick" style={`--column: ${String(year.startColumn)}`}>
          {year.label}
        </span>
      ))
    }
  </div>
  <ol class="trace-rows">
    {
      spans.map(({ span, role }) => (
        <li
          class:list={['trace-row', { 'trace-row-nested': span.nested }]}
          style={`--start: ${String(span.startColumn)}; --span: ${String(span.spanColumns)}`}
        >
          <span class="trace-bar" aria-hidden="true" />
          <span class="trace-label">
            <span class="text-ink">{role.data.company}</span>
            <span class="text-ink-muted">
              {' '}
              · {role.data.title} · {formatPeriod(role.data.period)}
              {span.nested && ' · concurrent'}
            </span>
          </span>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .trace {
    --row-gap: 0.75rem;
  }

  .trace-axis,
  .trace-row {
    display: grid;
    grid-template-columns: repeat(var(--months), minmax(0, 1fr));
  }

  .trace-axis {
    margin-top: 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.25rem;
    font-family: var(--font-plex-mono);
    font-size: var(--text-2xs);
    color: var(--ink-muted);
  }

  .trace-tick {
    grid-column: var(--column) / span 12;
    border-left: 1px solid var(--rule);
    padding-left: 0.35rem;
  }

  .trace-rows {
    display: flex;
    flex-direction: column;
    gap: var(--row-gap);
    margin-top: var(--row-gap);
  }

  .trace-row {
    row-gap: 0.35rem;
  }

  .trace-bar {
    grid-column: var(--start) / span var(--span);
    grid-row: 1;
    height: 0.5rem;
    background: var(--ink);
  }

  .trace-row-nested .trace-bar {
    height: 0.25rem;
    margin-top: 0.125rem;
    background: var(--accent);
  }

  .trace-label {
    grid-column: 1 / -1;
    grid-row: 2;
    font-family: var(--font-plex-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .trace-row-nested .trace-label {
    padding-left: 1rem;
  }
</style>
